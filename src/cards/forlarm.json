{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard", "version": "1.5",
  "body": [
    { "type": "Container", "style": "warning", "bleed": true, "items": [
      { "type": "TextBlock", "text": "⚠️ FÖRLARM", "weight": "Bolder", "size": "Large", "wrap": true },
      { "type": "TextBlock", "text": "Möjlig händelse — behöver bedömas", "weight": "Bolder", "wrap": true, "spacing": "None" }
    ]},
    { "type": "FactSet", "facts": [
      { "title": "Byggnad", "value": "{{byggnad}}" },
      { "title": "Zon", "value": "{{zon}}" },
      { "title": "Tid", "value": "{{klockslag}}" },
      { "title": "Källa", "value": "{{kalla}}" }
    ]},
    { "type": "TextBlock", "text": "{{forlarmText}}", "wrap": true },
    { "type": "TextBlock", "text": "Förlarm {{larmId}} · {{forlarmslage}}", "size": "Small", "isSubtle": true, "wrap": true }
  ]
}
